    <UserSecretsId>7f9dab59-2361-4da9-ba9e-fc93e7d2e6c3</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
